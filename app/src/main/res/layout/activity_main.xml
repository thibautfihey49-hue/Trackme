<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <EditText
        android:id="@+id/etNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Numéro de téléphone"
        android:inputType="phone"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPhotoBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📸 Photo Arrière"
        android:onClick="sendPhotoBack"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnPhotoFront"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📸 Photo Avant"
        android:onClick="sendPhotoFront"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnVideoBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎥 Vidéo Arrière (15s)"
        android:onClick="sendVideoBack"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnVideoFront"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎥 Vidéo Avant (15s)"
        android:onClick="sendVideoFront"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prêt"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

</LinearLayout>
